+	String compact = p_group_uuid.replace("-", "");
+	ERR_FAIL_COND_V_MSG(compact.length() != 32 || !compact.is_valid_hex_number(false), false, "Invalid group UUID");
+	ERR_FAIL_COND_V_MSG(space == XR_NULL_HANDLE, false, "Anchor does not exist");
+	PackedByteArray bytes = compact.hex_decode();
+	XrUuid group;
+	memcpy(group.data, bytes.ptr(), 16);
+	XrShareSpacesRecipientGroupsMETA recipient = { XR_TYPE_SHARE_SPACES_RECIPIENT_GROUPS_META, nullptr, 1, &group };
+	XrShareSpacesInfoMETA info = { XR_TYPE_SHARE_SPACES_INFO_META, nullptr, 1, &space, reinterpret_cast<XrShareSpacesRecipientBaseHeaderMETA *>(&recipient) };
+	Ref<OpenXRFbSpatialEntity> *userdata = memnew(Ref<OpenXRFbSpatialEntity>(this));
+	return OpenXRFbSpatialEntitySharingExtension::get_singleton()->share_spaces_with_group(&info, _on_share_with_group, userdata);
+}
+
+void OpenXRFbSpatialEntity::_on_share_with_group(XrResult p_result, void *p_userdata) {
+	auto *userdata = static_cast<Ref<OpenXRFbSpatialEntity> *>(p_userdata);
+	(*userdata)->emit_signal("openxr_meta_spatial_entity_group_shared", XR_SUCCEEDED(p_result), static_cast<int>(p_result));
+	memdelete(userdata);
+}
