XR_AGENT_HOST=0.0.0.0
XR_AGENT_PORT=8091
XR_AGENT_PROVIDER=local
# XR_AGENT_PROVIDER=google
XR_LOCAL_TLS_VERIFY=false

# Demo access token. Empty = open LAN development. When set, every request
# must present it via the X-XR-Demo-Token header or the ?token= query
# parameter (the Quest app carries it inside the websocket URL in
# user://agent_config.json).
XR_DEMO_TOKEN=

XR_STT_URL=http://127.0.0.1:8011/transcribe
XR_STT_HEALTH_URL=http://127.0.0.1:8011/healthz
XR_STT_LANGUAGE=auto
XR_LLM_URL=http://127.0.0.1:8015/v1/chat/completions
XR_LLM_HEALTH_URL=http://127.0.0.1:8015/v1/models
XR_LLM_MODEL=ministral-3-14b-vision-local
XR_TTS_URL=https://127.0.0.1:8020/v1/audio/speech
XR_TTS_HEALTH_URL=https://127.0.0.1:8020/health

XR_INPUT_SAMPLE_RATE=48000
XR_OUTPUT_SAMPLE_RATE=24000
XR_TTS_VOICE=default
XR_TTS_DEFAULT_LANGUAGE=it
XR_TTS_VOICE_MAP=
XR_TTS_RESPONSE_FORMAT=pcm16
# Stream local TTS PCM16 to the headset while it is being synthesized
# (only used by providers that support streaming; others fall back to
# buffered synthesis automatically).
XR_TTS_STREAM_ENABLED=true
XR_REQUEST_TIMEOUT_SECONDS=60
XR_HEALTH_TIMEOUT_SECONDS=2
XR_LLM_MAX_TOKENS=0
# Optional for llama.cpp thinking models; omit for other endpoints.
# XR_LLM_ENABLE_THINKING=false
XR_RESPONSE_MAX_CHARS=0
XR_VISION_AGENT_ENABLED=true
XR_VISION_SNAPSHOT_TIMEOUT_SECONDS=10
XR_VISION_DECISION_MAX_TOKENS=120

# Google Gemini Live provider. The Quest still connects only to this proxy.
# Use either API key mode or Vertex AI mode.
XR_GOOGLE_API_KEY=
XR_GOOGLE_USE_VERTEXAI=false
XR_GOOGLE_PROJECT_ID=
XR_GOOGLE_LOCATION=europe-west4
XR_GOOGLE_API_VERSION=v1beta
XR_GOOGLE_LIVE_MODEL=gemini-3.1-flash-live-preview
XR_GOOGLE_TEXT_MODEL=gemini-2.5-flash
XR_GOOGLE_VOICE_NAME=Charon
XR_GOOGLE_LANGUAGE_CODE=it-IT
XR_GOOGLE_INPUT_SAMPLE_RATE=16000
XR_GOOGLE_OUTPUT_SAMPLE_RATE=24000
XR_GOOGLE_AUDIO_CHUNK_BYTES=3200
XR_GOOGLE_TURN_TIMEOUT_SECONDS=60
XR_GOOGLE_TEMPERATURE=0.4
XR_GOOGLE_SNAPSHOT_TOOL_ENABLED=true
XR_GOOGLE_VIDEO_STREAM_ENABLED=false
XR_GOOGLE_VIDEO_MAX_FRAME_AGE_SECONDS=2.5
XR_GOOGLE_SYSTEM_INSTRUCTION=

# Optional NoiBot mouth cues: existing rhubarb-lip-sync-wasm 0.1.8 package directory.
XR_LIPSYNC_PACKAGE=
XR_LIPSYNC_TIMEOUT_SECONDS=12
