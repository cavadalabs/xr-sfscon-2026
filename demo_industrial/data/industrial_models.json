  {
    "title": "Compressore carrellato",
    "description": "Serbatoio, gruppo pompante e trasmissione a cinghia in un modello da osservare da vicino.",
    "category": "Pneumatica",
    "collection": "industrial",
    "color": "#47D8BC",
